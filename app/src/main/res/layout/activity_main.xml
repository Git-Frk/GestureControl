<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="28sp" android:textStyle="bold" android:textColor="#F1F7F6" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/subtitle" android:textSize="12sp" android:textColor="#75E4BD" android:layout_marginBottom="8dp" />
    <Switch android:id="@+id/backgroundTracking" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false"
        android:text="@string/background_enable" android:textColor="#F1F7F6" />
    <TextView android:id="@+id/backgroundStatus" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="@string/background_help"
        android:textColor="#B4C5CF" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" style="?android:attr/buttonBarStyle">
        <Button android:id="@+id/toggleCamera" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/start" />
        <Button android:id="@+id/tune" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/settings" />
        <Button android:id="@+id/appSettings" style="?android:attr/buttonBarButtonStyle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="@string/app_settings" />
    </LinearLayout>
    <GridLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:columnCount="2" android:rowCount="1">
    <FrameLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_columnWeight="1" android:layout_gravity="fill" android:background="#050A0D">
        <androidx.camera.view.PreviewView android:id="@+id/preview"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <dev.gestureos.ui.LandmarkOverlay android:id="@+id/overlay"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:importantForAccessibility="no" />
    </FrameLayout>
    <dev.gestureos.ui.CursorTestArea android:id="@+id/cursorArea"
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_columnWeight="1" android:layout_gravity="fill"
        android:layout_marginStart="8dp" android:background="#0C1920" />
    </GridLayout>
    <!-- Stable preview bounds: changing feedback text must not resize the camera viewport. -->
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingTop="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <Switch android:id="@+id/systemCursorEnabled" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false"
                    android:text="@string/system_cursor_enable" android:textColor="#F1F7F6" />
                <Button android:id="@+id/accessibilitySettings" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/accessibility_settings" />
            </LinearLayout>
            <TextView android:id="@+id/systemCursorStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/system_enable_requirements" android:textColor="#75E4BD" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/system_help" android:textColor="#B4C5CF" android:textSize="12sp" />
            <TextView android:id="@+id/systemMotionStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/motion_help" android:textColor="#75E4BD" android:textSize="12sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/motion_help" android:textColor="#B4C5CF" android:textSize="12sp" />
            <Button android:id="@+id/tuneMotion" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/motion_tune" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <Switch android:id="@+id/cursorEnabled" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:minHeight="48dp" android:saveEnabled="false"
                    android:text="@string/cursor_enable" android:textColor="#F1F7F6" />
                <Button android:id="@+id/cursorTune" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cursor_tune" />
            </LinearLayout>
            <TextView android:id="@+id/cursorStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minLines="2" android:text="@string/cursor_off" android:textColor="#75E4BD" android:textSize="14sp" />
            <TextView android:id="@+id/cursorFeedback" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/cursor_help" android:textColor="#F1F7F6" android:textSize="13sp"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/cursorLatency" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/cursor_latency_idle" android:textColor="#B4C5CF" android:textSize="12sp" />
            <TextView android:id="@+id/cameraStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/camera_off" android:textColor="#B4C5CF" android:textSize="13sp" />
            <TextView android:id="@+id/gesture" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/gesture_no_hand" android:textColor="#75E4BD" android:textSize="30sp" android:textStyle="bold" />
            <TextView android:id="@+id/recognitionState" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/state_no_hand" android:textColor="#F1F7F6" android:textSize="14sp" />
            <ProgressBar android:id="@+id/holdProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" android:max="100" />
            <TextView android:id="@+id/rawGesture" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#B4C5CF" android:textSize="12sp" />
            <TextView android:id="@+id/diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/diagnostics_idle" android:textColor="#B4C5CF" android:textSize="12sp"
                android:fontFamily="monospace" android:layout_marginTop="4dp" />
            <Switch android:id="@+id/volumeEnabled" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:text="@string/volume_enable" android:textColor="#F1F7F6"
                android:textSize="14sp" android:saveEnabled="false" />
            <TextView android:id="@+id/mediaVolume" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/volume_unavailable" android:textColor="#75E4BD" android:textSize="16sp" />
            <ProgressBar android:id="@+id/volumeProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="8dp" />
            <TextView android:id="@+id/volumeAction" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/volume_disabled" android:textColor="#B4C5CF" android:textSize="12sp"
                android:accessibilityLiveRegion="polite" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/instructions" android:textColor="#F1F7F6" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/privacy" android:textColor="#B4C5CF" android:textSize="11sp" android:layout_marginTop="4dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
